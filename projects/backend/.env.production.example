# ==============================================================================
# CommunityHub v1.0 Production Environment Variables (Backend)
# Copy to .env in projects/backend and populate values securely.
# ==============================================================================

NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# Supabase Cloud Database & Authentication
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
# Secret Service Role Key (NEVER expose to frontend or git)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Security & JWT Tokens
# ------------------------------------------------------------------------------
# Strong 256-bit secret string for signing session JWTs
JWT_SECRET=generate_a_secure_random_64_character_hex_secret_here

# ------------------------------------------------------------------------------
# CORS & Allowed Web Origins
# ------------------------------------------------------------------------------
# Target instances defined in RFP §10
FRONTEND_URL=https://hapacgh.org
ADDITIONAL_ORIGINS=https://commhub.heconf.net,https://www.hapacgh.org

# ------------------------------------------------------------------------------
# Email & SMTP (Email Mirroring & OTP Verification)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourdomain.org
SMTP_PASS=your_app_specific_password

# ------------------------------------------------------------------------------
# Twilio (SMS OTP & WhatsApp Delivery)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
