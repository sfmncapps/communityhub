# ==============================================================================
# CommunityHub v1.0 Production Environment Variables (Frontend)
# Copy to .env in projects/frontend before running 'npm run build'.
# ==============================================================================

# Relative or absolute API base path (e.g. /api when reverse-proxied by Nginx)
VITE_API_BASE_URL=/api

# Supabase Public Anonymous Keys (Safe for frontend client)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# Optional: Google Maps JavaScript API Key (Directory Map Clustering)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
