# ==============================================================================
# CommunityHub v1.0 Frontend Production Dockerfile
# Stage 1: Build Vite client bundle
# Stage 2: Serve through optimized minimal Nginx Alpine
# ==============================================================================

FROM node:20-alpine AS builder

WORKDIR /app

COPY projects/frontend/package*.json ./
RUN npm ci

COPY projects/frontend/ ./

ARG VITE_API_BASE_URL=/api
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN npm run build

# Stage 2: Web server runtime
FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Minimal Nginx SPA config
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
    location /assets/ { \
        root /usr/share/nginx/html; \
        expires 1y; \
        add_header Cache-Control "public, immutable"; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
